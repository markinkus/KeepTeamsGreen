<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>KeepTeamsGreen</AssemblyName>
    <RootNamespace>KeepTeamsGreen.Launcher</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == '' and Exists('..\KeepTeamsGreen.ico')">..\KeepTeamsGreen.ico</ApplicationIcon>
    <Title>KeepTeamsGreen</Title>
    <Product>KeepTeamsGreen</Product>
    <Company>Markino Solutions</Company>
    <Description>Centrale operativa per presenza Teams e auto-jitter</Description>
    <Copyright>Copyright Markino Solutions</Copyright>
    <Version>2.3.1.0</Version>
    <FileVersion>2.3.1.0</FileVersion>
    <AssemblyVersion>2.3.1.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.PowerShell.5.ReferenceAssemblies" Version="1.1.0" PrivateAssets="All" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
    <Compile Include="..\local\PresenceText.cs" Link="PresenceText.cs" />
    <Compile Include="..\local\PresenceReader.cs" Link="PresenceReader.cs" />
    <Compile Include="..\local\NotificationAudio.cs" Link="NotificationAudio.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\script.gui.ps1" LogicalName="script.gui.ps1" />
    <EmbeddedResource Include="..\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="..\local\Rules.ps1" LogicalName="local/Rules.ps1" />
    <EmbeddedResource Include="..\local\Operations.ps1" LogicalName="local/Operations.ps1" />
    <EmbeddedResource Include="..\local\PresenceText.cs" LogicalName="local/PresenceText.cs" />
    <EmbeddedResource Include="..\local\PresenceReader.cs" LogicalName="local/PresenceReader.cs" />
    <EmbeddedResource Include="..\local\Interactions.ps1" LogicalName="local/Interactions.ps1" />
    <EmbeddedResource Include="..\local\NotificationAudio.cs" LogicalName="local/NotificationAudio.cs" />
  </ItemGroup>
</Project>
